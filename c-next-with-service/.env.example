# Port aplikasi di host
APP_PORT=3000

# Port PostgreSQL di host (di dalam network compose selalu 5432)
POSTGRES_PORT=5433

POSTGRES_USER=kicau
POSTGRES_PASSWORD=kicau
POSTGRES_DB=kicau

# Isi data demo saat container pertama kali start
SEED_DEMO=true

# Ubah ke true kalau aplikasi diakses lewat HTTPS
COOKIE_SECURE=false
